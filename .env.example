# ── LLM provider ─────────────────────────────────────────────────────────────
# Which provider to use for chat completions.
# Options: openai | anthropic | openrouter | lmstudio | llama_cpp | custom
LLM_PROVIDER=openai

# Model to use for chat completions (provider-specific model ID).
LLM_MODEL=gpt-4o-mini

# ── API keys ──────────────────────────────────────────────────────────────────
# Set the key for whichever provider(s) you use.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# ── Custom / self-hosted provider (LLM_PROVIDER=custom) ──────────────────────
# CUSTOM_LLM_BASE_URL=http://localhost:8080/v1
# CUSTOM_LLM_API_KEY=
# ── llama.cpp server (LLM_PROVIDER=llama_cpp) ────────────────────────────
# Start llama-server first: llama-server -m /path/to/model.gguf --port 8080
# LLAMA_CPP_URL=http://localhost:8080/v1  # override if running on a different host/port
# LLM_MODEL=llama-3.2-8b-instruct        # must match the model ID reported by /v1/models
#
# For enrichment with llama.cpp, set ENRICHMENT_BACKENDS (no auth needed):
# ENRICHMENT_DEFAULT_BACKEND=llama_cpp_local
# ENRICHMENT_BACKENDS='[{"name":"llama_cpp_local","type":"http","mode":"openai","base_url":"http://localhost:8080/v1","model":"llama-3.2-8b-instruct","timeout":60}]'
# ── Embedding provider ───────────────────────────────────────────────────────
# Which provider to use for vector embeddings.
# Options: openai (default) | openrouter | custom
EMBED_PROVIDER=openai

# Embedding model name.
# Default: text-embedding-3-small (1536 dims).
# Changing this requires re-embedding all documents.
EMBED_MODEL=text-embedding-3-small

# API key for embeddings (falls back to OPENAI_API_KEY if unset).
# EMBED_API_KEY=

# Override the embedding API base URL (for custom/self-hosted providers).
# EMBED_BASE_URL=

# Override embedding vector dimensions (auto-detected from model name by default).
# Only change this if your model uses non-standard dimensions.
# EMBED_DIMENSIONS=1536

# ── Storage ───────────────────────────────────────────────────────────────────
# Prefer the discrete fields below — Dewie assembles them into a DSN itself.
# POSTGRES_DSN is an escape hatch for exotic drivers/options; if set, it wins.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dewie
POSTGRES_PASSWORD=dewie
POSTGRES_DB=dewie
# POSTGRES_DSN=postgresql+asyncpg://dewie:dewie@localhost:5432/dewie
REDIS_URL=redis://localhost:6379/0

# ── Browser tests ─────────────────────────────────────────────────────────────
# API key for browser E2E tests. Set before running `pytest tests/browser/`.
# BROWSER_TEST_API_KEY=
# ── Admin user (Docker) ───────────────────────────────────────────────────────
# Seeded automatically on container startup. Change before first run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ── Recursive query limits ────────────────────────────────────────────────────
DEFAULT_MAX_DEPTH=3
ABSOLUTE_MAX_DEPTH=10
MAX_NODES_PER_LEVEL=20
QUERY_TIMEOUT_SECONDS=30

# ── Rate limiting (requests per minute per client) ────────────────────────────
RATE_LIMIT_RPM=60

# ── Enrichment worker tuning ─────────────────────────────────────────────────
# Docs claimed per tick. Set to 1 for serial mode (finish one, fetch next).
# Recommended for local LLMs (ollama / lmstudio / llama_cpp).
# ENRICHMENT_BATCH_SIZE=1
#
# Seconds to sleep between ticks when the queue is empty (default 30).
# Set to 0 with ENRICHMENT_BATCH_SIZE=1 for maximum local throughput.
# ENRICHMENT_SLEEP_SECS=0

# ── Cache TTL in seconds ──────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300

# ── Data directory ─────────────────────────────────────────────────────────────
# Path to data bodies directory (for docker-compose volume mounts).
# DEWIE_DATA_DIR=./data/bodies
