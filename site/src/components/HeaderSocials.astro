---
// Override of Starlight's SocialIcons: prepend a "Docs" text link before the
// default social icons (GitHub), so docs live in the top bar, not a banner.
import type { Props } from "@astrojs/starlight/props";
import Default from "@astrojs/starlight/components/SocialIcons.astro";
---

<a href="/dewie/quickstart/" class="header-docs">Docs</a>
<Default {...Astro.props}><slot /></Default>

<style>
  .header-docs {
    align-self: center;
    margin-inline-end: 0.5rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }
  .header-docs:hover { color: var(--sl-color-text-accent); }
</style>
